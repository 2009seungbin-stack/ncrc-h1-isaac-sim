# Large derived archives (contents are tracked in their extracted form)
/R3_bundle.tgz
/h1_current_training_bundle_20260901.zip
/h1_upload_ready.zip

# TensorBoard event files (regenerable training telemetry, ~68MB)
*.tfevents
events.out.tfevents.*

# Multi-MB raw training logs
/R3_bundle_extracted/workspace/r3logs/train_R3A.log
/R3_bundle_extracted/workspace/r3logs/train_R3C.log

# Python bytecode
__pycache__/
*.pyc

# Large checkpoint/log packs (kept on server/board backups, not in git)
/G3_pack/
/S1_pack/
/eval_results/tr/

# Vendored plotting packages / caches (reinstallable)
**/_plotdeps/
**/.plot_packages/
**/.plot_cache/

# Unrelated local tool rollback (contains a 900MB installer)
/analysis/codex_rollback_20261008/

# Large result archives and chunked transfers (extracted contents are tracked)
*.tar.gz
**/chunks/*.bin
/tools/go2/*.bak.tgz

# Bulk checkpoints / rollout traces inside analysis (kept on server backups)
/analysis/**/*.pt
/analysis/**/traces/
/longrun_D1/ckpt/
